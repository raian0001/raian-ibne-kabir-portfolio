# Server port (automatically provided by platforms like Render, Railway, Heroku, Fly.io, cPanel)
PORT=3000

# Optional bind host (leave blank for dual-stack default, or set 0.0.0.0)
HOST=

# Replace with a private password of at least 8 characters (12+ recommended) before opening /admin
ADMIN_PASSWORD=

# Optional OpenAI API key to enable live AI chat (keep secret; never commit or expose in frontend)
OPENAI_API_KEY=

# Reverse-proxy hop count:
#   1 = Behind Nginx, Caddy, Cloudflare, Render, Railway, Fly.io, or cPanel (recommended default)
#   2 = Behind two proxies (e.g. Cloudflare -> Nginx -> Node)
#   0 = Direct connection without any reverse proxy
TRUST_PROXY_HOPS=1

# Cookie Secure flag mode: auto | true | false
#   auto = automatically sets Secure on HTTPS domains and allows HTTP on localhost/unencrypted test IPs
COOKIE_SECURE=auto

# Pin admin sessions strictly to a single IP address (set true only if your admin IP never changes)
ADMIN_BIND_IP=false

# Optional comma-separated list of additional allowed origins (leave blank to allow current domain automatically)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Optional subpath if hosted under a directory instead of domain root (e.g. /portfolio)
BASE_PATH=

# Optional persistent directory path for SQLite database and uploaded images (e.g. /var/data on Render Disk)
DATA_DIR=
